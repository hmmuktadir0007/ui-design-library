{
  "name": "ui-design-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate:data": "python scripts/validate_styles.py && python -m unittest scripts/test_validate_styles.py",
    "generate:thumbs": "python scripts/generate-thumbnails.py",
    "test:e2e": "npm run build && playwright test --project=mobile-375 --project=tablet-768 --project=desktop-1440",
    "test:e2e:compat": "npm run build && playwright test --project=firefox --project=webkit --project=mobile-touch",
    "capture:previews": "npm run build && node scripts/capture-previews.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
